# Copia este archivo a .env.local y rellena los valores.
# Supabase > Project Settings > API

# Públicas (se exponen en el navegador, es normal)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SECRETA — solo en el servidor. NO lleva prefijo NEXT_PUBLIC.
# Opcional pero recomendada: permite que /api/register inserte aunque se
# bloquee el insert anónimo directo (ver supabase-hardening.sql).
# En Vercel: Project Settings > Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para metadatos / SEO). Opcional.
SITE_URL=https://mambas-web.vercel.app

# Token público de Mapbox para el mapa oscuro (empieza con pk.).
# Opcional: el código ya trae un fallback, pero puedes ponerlo aquí / en Vercel
# para sobreescribirlo. Restringe el token a tu dominio en el panel de Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Secreto compartido para la sincronización con Google Calendar (Apps Script).
# Genera una cadena larga aleatoria y ponla igual aquí, en Vercel y en el script.
# Requiere también SUPABASE_SERVICE_ROLE_KEY configurada en Vercel.
SYNC_SECRET=
