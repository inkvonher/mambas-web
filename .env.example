# Copia este archivo a .env.local y rellena los valores.
# Supabase > Project Settings > API

# Públicas (se exponen en el navegador, es normal)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SECRETA — solo en el servidor. NO lleva prefijo NEXT_PUBLIC.
# Opcional pero recomendada: permite que /api/register inserte aunque se
# bloquee el insert anónimo directo (ver supabase-hardening.sql).
# En Vercel: Project Settings > Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para metadatos / SEO). Opcional.
SITE_URL=https://mambas-web.vercel.app
